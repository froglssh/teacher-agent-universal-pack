switch (command) {
  case 'flight':
  case 'flights':
    queryFlight(args[1], args[2], args[3]);
    break;
  case 'route':
  case 'routes':
    calculateRoute(args[1] || '台北車站', args[2] || '台北 101', args[3] || 'DRIVE');
    break;
  case 'rate':
  case 'rates':
    showRates(args[1] || 'TWD', args[2], parseFloat(args[3]) || 1);
    break;
  case 'convert':
    convert(args[1], args[2], args[3]);
    break;
  case 'weather':
    queryWeather(args[1] || 'Taipei');
    break;
  case 'bus':
    queryBus(args[1] || 'Taipei', args[2] || '307');
    break;
  case 'thsr':
  case 'hsr':
    queryThsr(args[1], args[2]);
    break;
  case 'tdx':
    checkTdx();
    break;
  case 'help':
  default:
    showHelp();
    break;
}
